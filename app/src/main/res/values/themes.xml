<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window before Compose draws: the curtain colour, so launch does not flash. -->
    <style name="Theme.Latent" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/curtain</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
